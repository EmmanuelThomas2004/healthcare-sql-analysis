1 = SELECT PatientName, City, InsuranceType FROM Patients WHERE Gender = 'Female' AND RegistrationDate > '2024-01-01' ORDER BY RegistrationDate DESC;

2=SELECT PatientID,SUM( TreatmentCost) AS TotalTreatmentCost,COUNT(AdmissionID) AS TotalAdmission FROM  Admissions GROUP BY PatientID HAVING SUM( TreatmentCost) > 3000;

3=SELECT PatientName,City FROM  Patients WHERE PatientID NOT IN (SELECT PatientID FROM Admissions);

4=SELECT P.PatientName,A.Diagnosis,SUM(A.TreatmentCost) AS TOTALTREATMENTCOST FROM  Admissions A INNER JOIN  Patients P ON P.PatientID = A.PatientID GROUP BY  P.PatientName,A.Diagnosis HAVING SUM(A.TreatmentCost) > (SELECT AVG(TreatmentCost) FROM  Admissions);|

5= SELECT D.DoctorName,SUM(CASE WHEN A. AdmissionType = 'Emergency' THEN 1 ELSE 0 END) AS EmergencyAdmissions,SUM(CASE WHEN A.AdmissionType = 'Elective' THEN 1 ELSE 0 END) AS ElectiveAdmissions FROM Doctors D INNER JOIN  Admissions A ON A.DoctorID = D.DoctorID GROUP BY D.DoctorName;

6=WITH TREATMENTCOST AS ( SELECT P.PatientName,SUM(A.TreatmentCost) AS TOTALTREATMENTCOST FROM  Admissions A INNER JOIN  Patients P ON P.PatientID = A.PatientID GROUP BY  P.PatientName) SELECT PatientName,TOTALTREATMENTCOST FROM TREATMENTCOST WHERE TOTALTREATMENTCOST > (SELECT AVG(TOTALTREATMENTCOST) FROM TREATMENTCOST);

7= WITH RECENTDATE AS (SELECT P.PatientName,A.Diagnosis,A.AdmissionDate,DENSE_RANK() OVER(PARTITION BY P.PatientName ORDER BY A.AdmissionDate DESC) AS RANKING FROM  Admissions A INNER JOIN  Patients P ON P.PatientID = A.PatientID) SELECT PatientName, Diagnosis,AdmissionDate FROM  RECENTDATE WHERE RANKING = 1;

8= SELECT PatientID,AdmissionDate,LAG(AdmissionDate) OVER(PARTITION BY PatientID) AS PREVADMISIONDATE FROM  Admissions;

9=WITH DOCTORRAN AS ( SELECT D. DoctorName,D.Department,SUM(A.TreatmentCost) AS TotalTreatmentCost,DENSE_RANK() OVER(PARTITION BY D.Department  ORDER BY SUM(A.TreatmentCost) DESC) AS RANKING  FROM  Admissions A INNER JOIN Doctors D ON D.DoctorID = A.DoctorID GROUP BY D. DoctorName,D.Department) SELECT * FROM  DOCTORRAN WHERE RANKING = 1;

10=SELECT COALESCE(P.InsuranceType,'Uninsured') AS INSURANCETYPE,ROUND(AVG(A.TreatmentCost),2) AS AVGTREATMENTCOST FROM  Admissions A INNER JOIN  Patients P ON P.PatientID = A.PatientID GROUP BY  COALESCE(P.InsuranceType,'Uninsured') ORDER BY AVGTREATMENTCOST DESC;

11=SELECT (SUM(CASE WHEN ReadmittedWithin30Days =  1 THEN  1 ELSE 0 END)*100 /COUNT(*)) AS RATE FROM Admissions;

12=SELECT P.PatientName,COUNT( DISTINCT A.DoctorID) AS UniqueDoctorCount FROM Admissions A INNER JOIN  Patients P ON P.PatientID = A.PatientID GROUP BY  P.PatientName HAVING COUNT( DISTINCT A.DoctorID) > 1;

13=SELECT D.DoctorName,COALESCE(COUNT(A.AdmissionID),0) AS TOTALADMISSION  FROM  Admissions A RIGHT JOIN Doctors D ON D.DoctorID = A.DoctorID GROUP BY D.DoctorName ORDER BY TOTALADMISSION DESC;

14=WITH DRCOST AS (SELECT D.DoctorName,SUM(A.TreatmentCost) AS DoctorTotalCost,D.Department FROM Admissions A INNER JOIN Doctors D ON D.DoctorID = A.DoctorID GROUP BY   D.DoctorName,D.Department) SELECT DoctorName ,DoctorTotalCost,Department FROM DRCOST WHERE DoctorTotalCost > (SELECT AVG(DoctorTotalCost) FROM DRCOST);




